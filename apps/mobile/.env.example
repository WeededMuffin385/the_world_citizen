# Google Maps browser key and vector JavaScript Map ID, read by the Expo server.
# Enable Maps JavaScript API, Geocoding API, and the COUNTRY boundary layer.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Android/iOS load /country-map from this Expo server origin.
# Use a reachable LAN address during development and an HTTPS origin in production.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_ORIGIN=
